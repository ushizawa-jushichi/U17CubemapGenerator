#pragma kernel CSMain

TextureCube<float4> _SourceTex;
SamplerState sampler_LinearClamp;
RWTexture2DArray<float4> _ResultTex;

float _Roughness;
uint _NumSamples;
uint _Resolution;
uint _Algorithm; // 0: GGX, 1: Gaussian/Bokeh
int _IsLinearToSRGB;
int _FaceIndex; // -1: use id.z, >=0: single face index
uint _OffsetY;
uint _BlockHeight;

static const float PI = 3.14159265359;

float3 LinearToSRGB(float3 c)
{
    c = max(c, float3(0.0, 0.0, 0.0));
    float3 sRGBLo = c * 12.92;
    float3 sRGBHi = (pow(max(c, 1.192092896e-07), float3(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) * 1.055) - 0.055;
    return (c <= 0.0031308) ? sRGBLo : sRGBHi;
}

// Hammersley sequence for low-discrepancy random numbers
float2 Hammersley(uint i, uint N)
{
    float rdi = float(reversebits(i)) * 2.3283064365386963e-10;
    return float2(float(i) / float(N), rdi);
}

// GGX Importance Sampling to generate sample vector
float3 ImportanceSampleGGX(float2 Xi, float3 N, float roughness)
{
    float a = roughness * roughness;
    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    // spherical to cartesian
    float3 H;
    H.x = cos(phi) * sinTheta;
    H.y = sin(phi) * sinTheta;
    H.z = cosTheta;

    // tangent to world space
    float3 up = abs(N.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
    float3 tangent = normalize(cross(up, N));
    float3 bitangent = cross(N, tangent);

    float3 sampleVec = tangent * H.x + bitangent * H.y + N * H.z;
    return normalize(sampleVec);
}

// Convert 2D pixel coordinate and face index to 3D direction vector
float3 GetDirectionFromCubemapTexel(uint2 pos, uint faceIndex, uint resolution)
{
    float2 uv = (float2(pos) + 0.5) / float(resolution);
    uv = uv * 2.0 - 1.0;
    uv.y = -uv.y; // Flip Y for correct cubemap mapping in Unity

    float3 dir = float3(0, 0, 0);
    if (faceIndex == 0) dir = float3(1.0, uv.y, -uv.x); // +X
    else if (faceIndex == 1) dir = float3(-1.0, uv.y, uv.x); // -X
    else if (faceIndex == 2) dir = float3(uv.x, 1.0, -uv.y); // +Y
    else if (faceIndex == 3) dir = float3(uv.x, -1.0, uv.y); // -Y
    else if (faceIndex == 4) dir = float3(uv.x, uv.y, 1.0); // +Z
    else if (faceIndex == 5) dir = float3(-uv.x, uv.y, -1.0); // -Z

    return normalize(dir);
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint face = (_FaceIndex >= 0) ? (uint)_FaceIndex : id.z;
    uint actualY = id.y + _OffsetY;

    if (id.x >= _Resolution || actualY >= _Resolution)
        return;

    if (_BlockHeight > 0 && id.y >= _BlockHeight)
        return;

    uint3 pixelCoord = uint3(id.x, actualY, face);
    float3 N = GetDirectionFromCubemapTexel(pixelCoord.xy, pixelCoord.z, _Resolution);

    float totalWeight = 0.0;
    float4 prefilteredColor = float4(0.0, 0.0, 0.0, 0.0);

    if (_Roughness < 0.001)
    {
        float4 color = _SourceTex.SampleLevel(sampler_LinearClamp, N, 0);
        if (_IsLinearToSRGB == 1)
        {
            color.rgb = LinearToSRGB(color.rgb);
        }
        _ResultTex[pixelCoord] = color;
        return;
    }

    // Specular IBL (GGX)
    if (_Algorithm == 0)
    {
        float3 V = N;
        for (uint i = 0u; i < _NumSamples; ++i)
        {
            float2 Xi = Hammersley(i, _NumSamples);
            float3 H = ImportanceSampleGGX(Xi, N, _Roughness);
            float3 L = normalize(2.0 * dot(V, H) * H - V);

            float NdotL = max(dot(N, L), 0.0);
            if (NdotL > 0.0)
            {
                float4 color = _SourceTex.SampleLevel(sampler_LinearClamp, L, 0);
                prefilteredColor += color * NdotL;
                totalWeight += NdotL;
            }
        }
    }
    // Gaussian / Bokeh Blur
    else
    {
        // _Roughness represents blur radius (0 to 90 degrees)
        float blurRadius = _Roughness * (PI / 2.0);
        float sigma = blurRadius / 3.0; // 3-sigma rule for Gaussian
        float twoSigmaSq = 2.0 * sigma * sigma;
        float cosBlurRadius = cos(blurRadius);

        float3 up = abs(N.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
        float3 tangent = normalize(cross(up, N));
        float3 bitangent = cross(N, tangent);

        for (uint i = 0u; i < _NumSamples; ++i)
        {
            float2 Xi = Hammersley(i, _NumSamples);

            // Map random point to a cone of angle 'blurRadius'
            float phi = 2.0 * PI * Xi.x;
            float cosTheta = lerp(1.0, cosBlurRadius, Xi.y);
            float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

            float3 H;
            H.x = cos(phi) * sinTheta;
            H.y = sin(phi) * sinTheta;
            H.z = cosTheta;

            // Transform to world space direction L
            float3 L = normalize(tangent * H.x + bitangent * H.y + N * H.z);

            // Calculate Gaussian weight based on angle from center (N)
            float angle = acos(cosTheta);
            float weight = exp(-(angle * angle) / twoSigmaSq);

            float4 color = _SourceTex.SampleLevel(sampler_LinearClamp, L, 0);
            prefilteredColor += color * weight;
            totalWeight += weight;
        }
    }

    prefilteredColor = prefilteredColor / max(totalWeight, 0.001);

    if (_IsLinearToSRGB == 1)
    {
        prefilteredColor.rgb = LinearToSRGB(prefilteredColor.rgb);
    }

    _ResultTex[pixelCoord] = prefilteredColor;
}
